+// t3flare (SPI-1391): a Terminal's history lives in its log file. Memory keeps only output not
+// yet written there; `lock` orders a write against a snapshot's read.
+class TerminalHistoryLog {
+  readonly lock = Semaphore.makeUnsafe(1);
+  // The file's size as this log last wrote it, and whether the next write replaces the file.
+  fileBytes = 0;
+  rewrite = true;
+  // A failed append may have left part of its output past `fileBytes`.
+  torn = false;
+  private pending: BoundedTerminalHistory;
+  private readonly maxLines: number;
+  private readonly maxBytes: number;
+
+  constructor(maxLines: number, maxBytes: number, initial = "") {
+    this.maxLines = maxLines;
+    this.maxBytes = maxBytes;
+    this.pending = new BoundedTerminalHistory(maxLines, initial, maxBytes);
+  }
+
+  append(text: string): void {
+    this.pending.append(text);
+  }
+
+  clear(): void {
+    this.pending.clear();
+    this.rewrite = true;
+  }
+
+  unwritten(): string {
+    return this.pending.value();
+  }
+
+  // A trailing high surrogate stays for its pair: UTF-8 cannot encode it alone.
+  take(): { readonly data: string; readonly rewrite: boolean } {
+    const value = this.pending.value();
+    const last = value.charCodeAt(value.length - 1);
+    const kept = last >= 0xd800 && last <= 0xdbff ? 1 : 0;
+    const taken = { data: value.slice(0, value.length - kept), rewrite: this.rewrite };
+    this.pending = new BoundedTerminalHistory(
+      this.maxLines,
+      value.slice(value.length - kept),
+      this.maxBytes,
+    );
+    this.rewrite = false;
+    return taken;
+  }
+
+  // A failed write's output goes back before what arrived since, unless a clear came between.
+  restore(taken: { readonly data: string; readonly rewrite: boolean }): void {
+    if (this.rewrite) return;
+    const pending = new BoundedTerminalHistory(this.maxLines, taken.data, this.maxBytes);
+    pending.append(this.pending.value());
+    this.pending = pending;
+    this.rewrite = taken.rewrite;
+  }
+}
