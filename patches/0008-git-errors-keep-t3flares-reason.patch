+// t3flare: the Cloud Environment's own refusals (lines starting `fatal: t3flare: `) join the detail; git's stderr
+// stays hidden (SPI-1182).
+const T3FLARE_FATAL = "fatal: t3flare: ";
+function t3flareReason(stderr: string): string {
+  const lines = stderr
+    .split(/\r?\n/)
+    .filter((line) => line.startsWith(T3FLARE_FATAL))
+    .map((line) => line.slice(T3FLARE_FATAL.length).trim());
+  return lines.length === 0 ? "" : `: ${lines.join("; ")}`;
+}
+
